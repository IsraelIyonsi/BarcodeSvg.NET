<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>BarcodeSvg</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BarcodeSvg.Net</PackageId>
    <Version>0.1.0</Version>
    <Title>BarcodeSvg.NET</Title>
    <Authors>Israel Iyonsi</Authors>
    <Copyright>Copyright (c) 2026 Israel Iyonsi</Copyright>
    <Description>Code 128 (auto code-set A/B/C) and EAN-13 barcodes rendered as self-contained SVG. Correct check digits, quiet zones and parity patterns, deterministic output, no System.Drawing or native dependency, AOT-friendly.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IsraelIyonsi/BarcodeSvg.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IsraelIyonsi/BarcodeSvg.NET</PackageProjectUrl>
    <PackageTags>barcode;svg;code128;ean13;code-128;ean-13;invoicing;label</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/IsraelIyonsi/BarcodeSvg.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarcodeSvg.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
